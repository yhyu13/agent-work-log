  "lessons": [
    {
      "id": "M-0001",
      "title": "统一记忆库必须先于公开投影",
      "repo": "cross-repo",
      "problem": "先做 Agent Lab 公开页，但跨 repo 经验仍散在聊天/PR/deliverables，无法稳定回注下一轮。",
      "lesson": "个人 Agent 的核心基础设施是统一记忆库；公开页、周报、Decision Tree 都只能做脱敏投影。先建正本，再做展示。",
      "conditions": "多 repo、多会话、需要长期自我迭代时。",
      "counterexamples": "单次一次性任务不需要统一记忆库。",
      "status": "candidate",
      "confidence": "observed",
      "source_type": "conversation",
      "source_ref": "2026-11-11 user correction: 我需要的就是一个统一的记忆库",
      "tags": "memory,architecture,priority"
    },
    {
      "id": "M-0002",
      "title": "批准声明不等于真实授权",
      "repo": "yhyu13.github.io",
      "problem": "JSON 中 approved/autoPublish 字段可能被页面误读为本人已批准和发布系统可用。",
      "lesson": "批准元数据只能证明声明完整；真实授权必须来自本人消息或工具回执。页面不得把声明写成已批准或可自动发布。",
      "conditions": "公开记录、自动发布、规则采用。",
      "counterexamples": "无。",
      "status": "candidate",
      "confidence": "observed",
      "source_type": "code/test",
      "source_ref": "AgentLabPage.tsx / agentLabSchema.mjs / agent-lab.spec.ts",
      "tags": "approval,publication,safety"
    },
    {
      "id": "M-0003",
      "title": "实测指标必须有有限值、样本、方法和证据",
      "repo": "cross-repo",
      "problem": "未测量值可能被填 0，或非有限数/缺样本被包装成收益。",
      "lesson": "measured/estimated 必须有限数值、单位、方法、正整数样本量、证据引用；时间 ROI 必须有正分母。未测量/不可比保持 null。",
      "conditions": "ROI、实验结果、公开指标。",
      "counterexamples": "探索性笔记可写假设，但不能标 measured。",
      "status": "candidate",
      "confidence": "observed",
      "source_type": "code/test",
      "source_ref": "agentLabSchema.mjs / check-agent-lab.test.mjs",
      "tags": "metrics,roi,truth"
    },
    {
      "id": "M-0004",
      "title": "合并授权必须绑定实时 PR head",
      "repo": "AgentSkillsVault",
      "problem": "旧批准可能被新提交复用，导致未经重新审查的合并。",
      "lesson": "绿黄红分级和合并批准必须绑定当前 PR head、检查项和批准主体；head 变化即失效。",
      "conditions": "多 Agent PR、自动合并、治理模板。",
      "counterexamples": "只读调查不需要合并授权。",
      "status": "candidate",
      "confidence": "observed",
      "source_type": "commit/PR",
      "source_ref": "AgentSkillsVault e791537 / PR #21",
      "tags": "governance,pr,approval"
    },
    {
      "id": "M-0005",
      "title": "引用检查要分范围，避免误判断链",
      "repo": "AgentSkillsVault",
      "problem": "ref gate 把源仓路径、模板路径、SKILL.md 引用混在一起检查，产生误报。",
      "lesson": "check_refs.py 管 SKILL.md 契约引用；治理检查管 repo docs；模板用 glob 解析，不写死 tier 路径。",
      "conditions": "skill vault、模板仓、多目录引用。",
      "counterexamples": "单一简单 docs 仓可简化。",
      "status": "candidate",
      "confidence": "observed",
      "source_type": "commit",
      "source_ref": "AgentSkillsVault 2c033bf / 6f48d96 / 626cd2a",
      "tags": "refcheck,ci,skills"
    },
    {
      "id": "M-0006",
      "title": "测试服部署不等于生产上线",
      "repo": "pbl",
      "problem": "语音输入修复部署到测试服后，容易被误报为生产已更新。",
      "lesson": "汇报必须分开测试服/生产版本、head、worker 状态；生产未动就明确写未动。",
      "conditions": "多环境部署、用户验收。",
      "counterexamples": "无。",
      "status": "candidate",
      "confidence": "observed",
      "source_type": "task digest",
      "source_ref": "AI_Turtor/pbl session 77fda2bf: test v1.7.22.92, prod v1.7.22.91",
      "tags": "deployment,truth,pbl"
    },
    {
      "id": "M-0007",
      "title": "Pad/输入法问题要真机验收和前后证据",
      "repo": "pbl",
      "problem": "语音转写、输入法 composition、课堂布局容易发一版修一层。",
      "lesson": "Pad 类改动要求真机验收清单；issue 中补修复前后截图/录屏证据；独立对抗测试后再收尾。",
      "conditions": "移动端输入、课堂 UI、语音转写。",
      "counterexamples": "纯后端逻辑可用自动化测试为主。",
      "status": "candidate",
      "confidence": "observed",
      "source_type": "commit/PR/issue",
      "source_ref": "pbl #266 / #278 / #279",
      "tags": "mobile,acceptance,evidence"
    },
    {
      "id": "M-0008",
      "title": "CI 绿不等于可合并，独立审查可 BLOCKED",
      "repo": "Aholo_Hackthon",
      "problem": "PR CI 通过但来源所有权/历史引用/审查阻塞未解决。",
      "lesson": "独立审查必须能 BLOCKED；CI 只是必要条件。历史引用要区分历史快照和现行依据，来源所有权要登记。",
      "conditions": "比赛仓、文档退役、多 PR 审查。",
      "counterexamples": "无。",
      "status": "candidate",
      "confidence": "observed",
      "source_type": "commit/PR comment",
      "source_ref": "Aholo_Hackthon spec-008 / PR #130 #131 #132 GRADE",
      "tags": "review,ci,ownership"
    },
    {
      "id": "M-0009",
      "title": "研究产物先隔离，论文说法回原文核对",
      "repo": "SimCity",
      "problem": "AI 模拟/知识库研究可能污染 repo，或把二手说法当事实。",
      "lesson": "研究脚本和产物放临时目录；论文阈值/频率等回原文核对；未写入 repo 就不说 repo 已更新。",
      "conditions": "研究型任务、外部论文、沙盒复刻。",
      "counterexamples": "明确要入库的实现任务除外。",
      "status": "candidate",
